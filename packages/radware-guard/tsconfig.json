{
  "compilerOptions": {
    "strict": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "lib": ["es2022"],
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "strictNullChecks": true,
    "useUnknownInCatchVariables": true,
    // n8n-workflow ships .d.ts files referencing express, luxon, ssh2 and DOM
    // globals we neither install nor need. Upstream Radware sets this too.
    "skipLibCheck": true,
    "outDir": "./dist/",
    "rootDir": "."
  },
  "include": ["credentials/**/*", "nodes/**/*", "nodes/**/*.json"],
  "exclude": ["node_modules", "dist", "tests"]
}
