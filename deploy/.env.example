# Copy to .env and fill in. .env is gitignored and must stay that way.
#   cp deploy/.env.example deploy/.env

# ---------------------------------------------------------------------------
# Public identity
# ---------------------------------------------------------------------------
N8N_DOMAIN=radware.ztat.me
LETSENCRYPT_EMAIL=you@example.com
GENERIC_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# Secrets at rest
# ---------------------------------------------------------------------------
# openssl rand -hex 32
# Back this up somewhere outside the box. If you lose it, every credential
# stored in the database becomes permanently unreadable, including the Radware
# keys, and the instance has to be rebuilt from scratch.
N8N_ENCRYPTION_KEY=

# openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=n8n
POSTGRES_DB=n8n

# ---------------------------------------------------------------------------
# Instance owner, provisioned on first boot with no setup wizard
# ---------------------------------------------------------------------------
N8N_INSTANCE_OWNER_EMAIL=you@example.com
N8N_INSTANCE_OWNER_FIRST_NAME=Radware
N8N_INSTANCE_OWNER_LAST_NAME=Lab
# bcrypt hash, not the password itself:
#   pnpm hash-password
N8N_INSTANCE_OWNER_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Radware keys, used ONLY by the validation harness in scripts/.
#
# n8n does not read these. Inside n8n the same keys live in encrypted
# credentials, entered through the UI. They are duplicated here so the
# out-of-band validation script can reproduce the same matrix without going
# through the editor.
# ---------------------------------------------------------------------------
# From a homegrown agent created with In-Path Enforcement. Starts sk-rdwr-.
RADWARE_INPATH_API_KEY=
# Provider segment Radware forwards to. Default openai.
RADWARE_PROVIDER=openai
RADWARE_MODEL=gpt-4o

# From a homegrown agent created with OUT-OF-PATH Enforcement. This is a
# different agent, and therefore usually a different key, from the in-path one.
# Leave blank to skip the out-of-path half of the validation run.
RADWARE_OUTOFPATH_API_KEY=
